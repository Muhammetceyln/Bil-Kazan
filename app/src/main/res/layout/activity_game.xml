<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"> <!-- Genel uzay arka planı -->

    <!-- Üst Logo -->
    <ImageView
        android:id="@+id/ivGameLogo"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/logo"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Statü Barı (Soru / Süre / Puan) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#33000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#4DFFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/ivGameLogo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:weightSum="3">

            <!-- Soru Sayısı -->
            <TextView
                android:id="@+id/tvQuestionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Soru: 0 / 10"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="start"/>

            <!-- Süre Göstergesi (Yuvarlak Çerçeveli) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_timer_circle"
                    android:text="Süre\n25s"
                    android:textColor="#FFC107"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="8dp"/>
            </LinearLayout>

            <!-- Puan -->
            <TextView
                android:id="@+id/tvCurrentScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Puan: 0"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:gravity="end"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Soru Kartı -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#4D64B5F6"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#80FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardStats">

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp"
            android:text="Türkiye'nin başkenti hangi şehirdir?"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:minHeight="150dp"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Kazanılan Puan Animasyon Metni (Doğru bilince görünür olacak) -->
    <TextView
        android:id="@+id/tvPlusScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+50 Puan"
        android:textColor="#4CAF50"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="invisible"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/llAnswers"
        app:layout_constraintEnd_toEndOf="@id/llAnswers"
        android:layout_marginEnd="32dp"/>

    <!-- Cevap Şıkları (2x2 Grid Yapısı) -->
    <LinearLayout
        android:id="@+id/llAnswers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardQuestion">

        <!-- 1. Satır (A ve B) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <!-- A Şıkkı -->
            <LinearLayout
                android:id="@+id/btnOptionA"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:background="@drawable/bg_answer_normal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_letter"
                    android:text="A"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvOptionA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İstanbul"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- B Şıkkı -->
            <LinearLayout
                android:id="@+id/btnOptionB"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:background="@drawable/bg_answer_normal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_letter"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvOptionB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ankara"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Satır (C ve D) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- C Şıkkı -->
            <LinearLayout
                android:id="@+id/btnOptionC"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:background="@drawable/bg_answer_normal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_letter"
                    android:text="C"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvOptionC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İzmir"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- D Şıkkı -->
            <LinearLayout
                android:id="@+id/btnOptionD"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:background="@drawable/bg_answer_normal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_letter"
                    android:text="D"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvOptionD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adana"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>