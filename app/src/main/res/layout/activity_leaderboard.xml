<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg">

    <!-- Üst Logo ve Başlık -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKOR TABLOSU"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Geçerli Kullanıcı (Siz) Kartı -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCurrentUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#4D00103A"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#80FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/user"
                android:background="@drawable/bg_circle_white"
                android:padding="2dp"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLeaderboardUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvLeaderboardUserScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#90CAF9"
                        android:textSize="13sp"
                        android:layout_marginEnd="16dp"/>

                    <TextView
                        android:id="@+id/tvLeaderboardUserRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFD700"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Arama ve Filtreleme (Hocanın İstediği Sorgu Arayüzü) -->
    <LinearLayout
        android:id="@+id/llSearchFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardCurrentUser">

        <EditText
            android:id="@+id/etSearchUser"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_bar"
            android:hint="Kullanıcı Ara..."
            android:textColorHint="#80FFFFFF"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:drawableEnd="@android:drawable/ic_menu_search"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnSortGeneral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Genel Sıralama"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_chip_selected"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnSortWeekly"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A'dan Z'ye Sırala"
                android:textColor="#B3FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_chip_unselected"
                android:paddingVertical="8dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- İlk 3 Podyum Kartları -->
    <LinearLayout
        android:id="@+id/llPodium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/llSearchFilter">

        <!-- 2. Sıra (Gümüş) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_podium_silver"
            android:padding="12dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥈" android:textSize="24sp"/>
            <TextView android:id="@+id/tvRank2Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tvRank2Score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E0E0E0" android:textSize="10sp"/>
        </LinearLayout>

        <!-- 1. Sıra (Altın) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_podium_gold"
            android:padding="16dp"
            android:layout_marginHorizontal="6dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="32sp"/>
            <TextView android:id="@+id/tvRank1Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tvRank1Score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="11sp"/>
        </LinearLayout>

        <!-- 3. Sıra (Bronz) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_podium_bronze"
            android:padding="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🥉" android:textSize="24sp"/>
            <TextView android:id="@+id/tvRank3Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tvRank3Score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E0E0E0" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Diğer Oyuncuların Listesi (ListView) -->
    <ListView
        android:id="@+id/listViewLeaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:divider="#33FFFFFF"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/llPodium"
        app:layout_constraintBottom_toTopOf="@id/tvFooterText" />

    <!-- Footer -->
    <TextView
        android:id="@+id/tvFooterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2024 BilKazan. Tüm hakları saklıdır."
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>